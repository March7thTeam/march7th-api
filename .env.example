APP_NAME=march7th api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8790
APP_BASE_URL=http://localhost:8790
SECURITY_CONTACT=security@example.com

DATABASE_PATH=/app/data/luomoapi.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

ASTRBOT_BASE_URL=
ASTRBOT_API_KEY=
ASTRBOT_BRIDGE_TOKEN=

LUOMOCORE_BASE_URL=
LUOMOCORE_API_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_VERIFICATION_TTL_HOURS=24

GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=

# Reverse proxy peers whose X-Forwarded-For is trusted (comma-separated IPs).
TRUSTED_PROXY_PEERS=127.0.0.1,::1,172.20.0.1

# AI model gateway (OpenAI-compatible upstream).
CODEXPROXY_BASE_URL=http://codex-proxy:8317
CODEXPROXY_API_KEY=

# Credit top-up payments (leave empty to disable online payment).
CREDIT_PAYMENT_PROVIDER=
CREDIT_STRIPE_SECRET_KEY=
CREDIT_STRIPE_WEBHOOK_SECRET=
CREDIT_STRIPE_ACCOUNT_ID=
CREDIT_STRIPE_LIVEMODE=true

# Opt in to image input on explicitly supported, priced text models.
GATEWAY_IMAGE_INPUT=false

# Opt in to text-to-image generation via the fixed official OpenAI Images API.
# Server-only project key; never put this key in client/browser code.
GATEWAY_IMAGE_GENERATION=false
GATEWAY_IMAGE_API_KEY=

# Optional native Responses transport for eight explicitly listed GPT6/5.6 models.
# Other model IDs and Chat Completions keep CodexProxy (see docs/GATEWAY.md).
# Selected native models without a key return503 before reservation; no fallback.
GATEWAY_NATIVE_RESPONSES=false
GATEWAY_NATIVE_RESPONSES_API_KEY=
